# Variables de entorno de K-Secure. Copiar a .env y completar:  cp .env.example .env
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Base interna de K-Secure ------------------------------------------------------------------
# Sin esta variable, K-Secure usa un SQLite local en data/ksecure.db.
# En la nube (Neon): postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/ksecure?sslmode=require
# Con docker compose se arma sola a partir de las variables POSTGRES_* de abajo.
KSECURE_DB_URL=

# --- Primer administrador ----------------------------------------------------------------------
# Formato usuario:contraseña. Se crea al arrancar solo si la base no tiene cuentas.
# La contraseña real va SOLO en .env (que no se sube); aquí queda una de ejemplo porque el repo es público.
# Al ingresar, K-Secure pide cambiar la contraseña y registrar un correo.
KSECURE_ACCESO=K-SECURE:cambiar-esta-clave-123

# --- Correo para recuperar contraseñas (opcional) ----------------------------------------------
# URL /exec del Apps Script (docs/apps-script-correo.gs) y su propiedad SECRETO.
# Sin ellas, el código de recuperación aparece en la terminal donde corre uvicorn.
KSECURE_CORREO_URL=
KSECURE_CORREO_SECRETO=

# --- Docker compose: PostgreSQL de la base interna ---------------------------------------------
POSTGRES_USER=ksecure
POSTGRES_PASSWORD=cambiar-esta-clave-db
POSTGRES_DB=ksecure

# --- Docker compose: base del cliente ficticio (perfil "demo") ---------------------------------
CLIENTE_DB_USER=cliente
CLIENTE_DB_PASSWORD=cambiar-esta-clave-cliente
